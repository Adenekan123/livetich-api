# Copy to deploy/.env.prod ON THE STAGING BOX and fill in. NEVER commit the real file.
#   cp deploy/.env.staging.example deploy/.env.prod
#
# Note the target name is .env.prod, NOT .env.staging: docker-compose.prod.yml
# has `env_file: deploy/.env.prod` baked into the web + api services, so the
# containers load that exact filename. Staging differs from production by BRANCH
# and by the VALUES below (domains, DB, secrets) — not by the filename.
#
# Staging is a SEPARATE Vultr instance tracking the `staging` git branch, not
# `main`. Bring it up exactly like prod:
#   docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml up -d --build
#
# Generate every secret fresh — DO NOT reuse production secrets on staging.
#   openssl rand -base64 48

# ---- Domains (DNS A records must point at the STAGING server IP) ----
APP_DOMAIN=staging.livetich.nekan.dev
API_DOMAIN=api-staging.livetich.nekan.dev
ACME_EMAIL=you@example.com                                 # Let's Encrypt notifications

# ---- Public URLs (baked into the web build + used for CORS/links) ----
NEXT_PUBLIC_API_URL=https://api-staging.livetich.nekan.dev # browser + SSR → API
WEB_ORIGIN=https://staging.livetich.nekan.dev              # API CORS allowlist (required)
WEB_URL=https://staging.livetich.nekan.dev                 # base for password-reset links
CERT_VERIFY_BASE=https://api-staging.livetich.nekan.dev/certificates/verify

# ---- Auth (generate a DISTINCT secret — never the prod one) ----
JWT_SECRET=change-me-openssl-rand-base64-48

# ---- MySQL (self-hosted container, separate data from prod) ----
MYSQL_ROOT_PASSWORD=change-me-strong-staging
MYSQL_DATABASE=livetich
MYSQL_USER=livetich
MYSQL_PASSWORD=change-me-strong-staging
# Must match the four MYSQL_* values above (host = the compose service name).
DATABASE_URL=mysql://livetich:change-me-strong-staging@mysql:3306/livetich

# ---- Redis (self-hosted container) ----
REDIS_URL=redis://redis:6379

# ---- Object storage: local disk (matches the `storage` volume). ----
STORAGE_DIR=/app/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=livetich-staging

# ---- LiveKit (use the free Cloud tier; a separate project keeps staging media
#      isolated from prod). Leave the `livekit` compose profile OFF. ----
LIVEKIT_URL=wss://your-staging-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- AI (Gemini). Use a low/test-quota key so staging can't burn prod budget. ----
GEMINI_API_KEY=
# Leave CODING_AI_MODEL unset to use the default gemini-flash-lite-latest.

# ---- Email (Resend). Leave the key blank on staging so reset/verify emails are
#      only LOGGED, never sent to real inboxes. ----
RESEND_API_KEY=
MAIL_FROM=no-reply@staging.livetich.nekan.dev

# ---- Test Prep add-on (optional): ALOC past-questions API. Use your own key. ----
ALOC_API_KEY=

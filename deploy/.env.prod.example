# Copy to deploy/.env.prod and fill in. NEVER commit the real file.
#   cp deploy/.env.prod.example deploy/.env.prod
# Used both for compose ${...} interpolation (--env-file) and as each service's
# container env. Generate secrets with:  openssl rand -base64 48

# ---- Domains (DNS A records must point at this server) ----
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com                       # Let's Encrypt notifications

# ---- Public URLs (baked into the web build + used for CORS/links) ----
NEXT_PUBLIC_API_URL=https://api.example.com      # browser + SSR → API
WEB_ORIGIN=https://app.example.com               # API CORS allowlist (required in prod)
WEB_URL=https://app.example.com                  # base for password-reset links
CERT_VERIFY_BASE=https://api.example.com/certificates/verify

# ---- Shared board (tldraw commercial license) ----
# Read server-side by the web container at runtime (NOT a build arg — no rebuild
# needed to change it; recreate the `web` container). Without it the classroom
# whiteboard renders the tldraw watermark. Same key as prod.
TLDRAW_LICENSE_KEY=

# ---- Auth ----
JWT_SECRET=change-me-openssl-rand-base64-48

# ---- MySQL (self-hosted container) ----
MYSQL_ROOT_PASSWORD=change-me-strong
MYSQL_DATABASE=livetich
MYSQL_USER=livetich
MYSQL_PASSWORD=change-me-strong
# Must match the four MYSQL_* values above (host = the compose service name).
DATABASE_URL=mysql://livetich:change-me-strong@mysql:3306/livetich

# ---- Redis (self-hosted container) ----
REDIS_URL=redis://redis:6379

# ---- Object storage: local disk (matches the `storage` volume). Leave R2 blank
#      unless you switch to Cloudflare R2 (then all four R2_* must be set). ----
STORAGE_DIR=/app/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=livetich

# ---- LiveKit ----
# Easiest: LiveKit Cloud free tier — set these three, leave the `livekit`
# compose profile OFF. Self-hosted (--profile livekit): use ws://API_DOMAIN or
# the server IP and keys that match deploy/livekit.yaml (see DEPLOY.md).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Email (Resend). Without a key, reset/verify emails are logged, not sent. ----
RESEND_API_KEY=
MAIL_FROM=no-reply@example.com

# ---- Test Prep add-on (optional): ALOC past-questions API ----
ALOC_API_KEY=

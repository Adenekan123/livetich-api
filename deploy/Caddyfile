# Auto-HTTPS via Let's Encrypt. Caddy proxies websockets (Socket.IO upgrades)
# transparently, so no extra config is needed for the live classroom.
{
	email {$ACME_EMAIL}
	servers {
		# Trust private networks and all official Cloudflare proxy IP CIDRs
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

# The platform admin console is IP-restricted at the edge: even a valid operator
# session can't reach /admin from outside these IPs. ADMIN_ALLOW_IPS is a
# space-separated list of IPs/CIDRs (add your IPv6 too if you have one).
# Fail-closed: if unset it defaults to localhost only, blocking all external
# admin access until you set it. client_ip matches against real client IP via trusted proxies.

# Web app
{$APP_DOMAIN} {
	encode zstd gzip

	# /admin (dashboard) + /admin-unlock (step-up gate)
	@admin path /admin /admin/* /admin-unlock /admin-unlock/*
	handle @admin {
		@allowed client_ip {$ADMIN_ALLOW_IPS:127.0.0.1/32}
		handle @allowed {
			reverse_proxy web:3000
		}
		handle {
			respond "Forbidden — admin access is restricted by IP." 403
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

# API (REST + Socket.IO). CORS is handled by the API itself (WEB_ORIGIN).
{$API_DOMAIN} {
	encode zstd gzip

	# /admin/* API routes — same IP restriction as the dashboard.
	@admin path /admin /admin/*
	handle @admin {
		@allowed client_ip {$ADMIN_ALLOW_IPS:127.0.0.1/32}
		handle @allowed {
			reverse_proxy api:3000
		}
		handle {
			respond "Forbidden — admin access is restricted by IP." 403
		}
	}

	handle {
		reverse_proxy api:3000
	}
}


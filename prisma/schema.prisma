generator client {
  provider      = "prisma-client-js"
  // Explicit engine for the Debian 12 (OpenSSL 3.0) runtime container, so the
  // client always ships the right query engine even if `native` mis-detects
  // during the Docker build. See Dockerfile (openssl installed in build stage).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  INSTRUCTOR
  STUDENT
  ORG_ADMIN
}

/**
 * Account access state. Disabled users cannot log in and their live sessions
 * are rejected on the next request (the JWT guard checks this).
 */
enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum QuizType {
  SECTION
  BUZZER
}

enum PointsReason {
  QUIZ_CORRECT
  BUZZER_WIN
  PARTICIPATION
  ASSIGNMENT_GRADED
}

/// Lifecycle of a remediation task auto-assigned after a missed topic.
enum RemediationStatus {
  PENDING
  DONE
}

/// A Hifz recitation is either freshly memorized material or revision (muraja'ah).
enum HifzKind {
  NEW_HIFZ
  REVISION
}

/// A tenant: the teaching company. Owns its people, courses, and brand kit.
model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  // ---- Brand kit ----
  logoUrl      String?
  primaryColor String? // hex, e.g. "#0a0a0a" — drives themed accents
  accentColor  String?
  tagline      String?

  // ---- Class preferences (admin toggles; apply to every class in the org) ----
  /// End class removes students from the room (vs. leaving them on the board).
  evictOnInstructorLeave Boolean @default(false)
  /// A student can only be granted the mic while their hand is raised; lowering
  /// it auto-revokes. (Students are muted-until-granted regardless.)
  micRequiresRaisedHand  Boolean @default(false)
  /// Email enrolled students ahead of each class occurrence.
  preClassReminder       Boolean @default(false)
  /// Lead time for that reminder, in minutes before the meeting start.
  reminderLeadMinutes    Int     @default(30)

  createdAt    DateTime @default(now())

  users      User[]
  courses    Course[]
  invites    Invite[]
  orgPlugins OrgPlugin[]
}

/// An enabled add-on pack for a tenant. The catalog of pluginKeys lives in code
/// (plugins/catalog.ts); a row here means "this org has this pack turned on".
/// Free during the pilot; the same row becomes the paywall entitlement later.
model OrgPlugin {
  id             String   @id @default(cuid())
  organizationId String
  pluginKey      String
  enabledAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pluginKey])
  @@index([organizationId])
}

/// A shareable registration link that binds the joiner to an org + role.
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  role           Role // STUDENT or INSTRUCTOR
  /// When set, the link is scoped to one program: a STUDENT is auto-enrolled on
  /// join, an INSTRUCTOR is assigned to teach it. Null = a plain workspace link.
  courseId       String?
  token          String    @unique
  label          String?
  createdById    String
  maxUses        Int? // null = unlimited
  uses           Int       @default(0)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation("inviteCreator", fields: [createdById], references: [id])
  course       Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([courseId])
}

model User {
  id             String     @id @default(cuid())
  role           Role
  status         UserStatus @default(ACTIVE)
  // Platform operator flag — grants the cross-org /admin console. Deliberately
  // NOT a Role value so it can't be obtained through registration/invite; it is
  // set only by another super-admin (or the bootstrap script). See SuperAdminGuard.
  isSuperAdmin   Boolean    @default(false)
  name           String
  email          String     @unique
  passwordHash   String
  organizationId String?
  createdAt      DateTime   @default(now())

  // Password reset — a hashed one-time token + its expiry (see auth.service).
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  // Email verification — hashed 6-digit OTP + expiry; gate is enforced in the guard.
  emailVerified      Boolean   @default(false)
  verifyOtpHash      String?
  verifyOtpExpiresAt DateTime?

  organization             Organization?         @relation(fields: [organizationId], references: [id])
  coursesTaught            Course[]              @relation("instructor")
  enrollments              Enrollment[]
  chatMessages             ChatMessage[]
  quizAnswers              QuizAnswer[]
  pointsEntries            PointsLedger[]
  certificates             Certificate[]         @relation("certStudent")
  createdInvites           Invite[]              @relation("inviteCreator")
  attendances              Attendance[]
  createdAssignments       Assignment[]          @relation("assignmentCreator")
  submissions              Submission[]          @relation("submissionStudent")
  groupMemberships         StudentGroupMember[]
  assessmentAttempts       AssessmentAttempt[]
  remediations             AssignedRemediation[]
  hifzTargets              HifzTarget[]          @relation("hifzTargetStudent")
  hifzTargetsSet           HifzTarget[]          @relation("hifzTargetCreator")
  hifzEntries              HifzEntry[]           @relation("hifzEntryStudent")
  hifzEntriesRecorded      HifzEntry[]           @relation("hifzEntryRecorder")
  examsCreated             Exam[]                @relation("examCreator")
  examAttempts             ExamAttempt[]         @relation("examAttemptStudent")
  // Coding Instructor Plugin
  codingAssignmentsCreated CodingAssignment[]    @relation("codingCreator")
  codingSubmissions        CodingSubmission[]    @relation("codingStudent")
  codingReviewed           CodingSubmission[]    @relation("codingReviewer")
  codingFeedback           CodingFeedback[]      @relation("codingFeedbackAuthor")

  @@index([organizationId])
}

model Course {
  id             String   @id @default(cuid())
  organizationId String? // owning tenant (backfilled; always set for new courses)
  instructorId   String? // assigned by the org admin; null = unassigned
  /// Set on a *batch*: the program (parent Course) it's a scheduled instance of.
  /// null = this row is itself a program. A program's content (syllabus,
  /// assessment questions, assignments, documents) is snapshotted into each
  /// batch at creation; the batch then owns its own schedule + roster + runtime.
  parentCourseId String?
  title          String
  description    String?  @db.Text
  posterUrl      String?
  createdAt      DateTime @default(now())

  // ---- Cohort program (descriptive; live sessions are still scheduled per occurrence) ----
  category          String? // e.g. "Software Engineering", "Design", "Business"
  level             String? // "Beginner" | "Intermediate" | "Advanced"
  startDate         DateTime? // first day of the cohort
  durationWeeks     Int? // program length; drives the end date + "N weeks" label
  /// Weekly meeting days as int[] (0=Sun … 6=Sat). MySQL has no array type.
  meetingDays       Json?
  meetingTime       String? // local start time, 24h "HH:mm" (e.g. "18:00")
  timezone          String? // IANA zone or short label shown to students (e.g. "Africa/Lagos" / "WAT")
  /// Bumped whenever a schedule field changes; drives "your reminder is stale".
  scheduleUpdatedAt DateTime?
  /// Release the class-end quiz to students the moment class ends (default).
  /// Off = it's held until the instructor releases it. Set by the instructor in
  /// the Assessments tool. Inherited by batches at creation (snapshot).
  instantClassAssessment Boolean @default(true)

  organization        Organization?        @relation(fields: [organizationId], references: [id])
  instructor          User?                @relation("instructor", fields: [instructorId], references: [id])
  parentCourse        Course?              @relation("ProgramBatches", fields: [parentCourseId], references: [id])
  batches             Course[]             @relation("ProgramBatches")
  sections            Section[]
  enrollments         Enrollment[]
  invites             Invite[]
  sessions            LiveSession[]
  sessionReminders    SessionReminder[]
  points              PointsLedger[]
  certificates        Certificate[]
  assignments         Assignment[]
  studentGroups       StudentGroup[]
  assessmentQuestions AssessmentQuestion[]
  quizzes             Quiz[]
  remediationTasks    RemediationTask[]
  assessments         Assessment[]
  documents           CourseDocument[]
  hifzTargets         HifzTarget[]
  hifzEntries         HifzEntry[]
  exams               Exam[]
  codingAssignments   CodingAssignment[]

  @@index([instructorId])
  @@index([organizationId])
  @@index([parentCourseId])
}

model Section {
  id          String  @id @default(cuid())
  courseId    String
  order       Int
  title       String
  description String? @db.Text

  course              Course               @relation(fields: [courseId], references: [id])
  quizzes             Quiz[]
  session             LiveSession[]
  assignments         Assignment[]
  assessmentQuestions AssessmentQuestion[]
  remediationTasks    RemediationTask[]

  @@unique([courseId, order])
}

/// Coursework set by the instructor/admin; students submit once each.
model Assignment {
  id           String    @id @default(cuid())
  courseId     String
  sectionId    String?
  /// Optional live session this coursework is tied to (e.g. homework from a class).
  sessionId    String?
  /// Target audience: null = whole class; set = only this group's members.
  groupId      String?
  title        String
  instructions String?   @db.Text
  dueAt        DateTime?
  maxPoints    Int?
  createdById  String
  createdAt    DateTime  @default(now())

  course      Course        @relation(fields: [courseId], references: [id])
  section     Section?      @relation(fields: [sectionId], references: [id])
  session     LiveSession?  @relation(fields: [sessionId], references: [id])
  group       StudentGroup? @relation(fields: [groupId], references: [id])
  createdBy   User          @relation("assignmentCreator", fields: [createdById], references: [id])
  submissions Submission[]

  @@index([courseId])
}

/// A named subset of a course's students (manual or performance-based), used to
/// target assignments/tasks. A student may belong to multiple groups.
model StudentGroup {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  createdAt DateTime @default(now())

  course      Course               @relation(fields: [courseId], references: [id])
  members     StudentGroupMember[]
  assignments Assignment[]

  @@index([courseId])
}

model StudentGroupMember {
  id        String @id @default(cuid())
  groupId   String
  studentId String

  group   StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id])

  @@unique([groupId, studentId])
  @@index([studentId])
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?   @db.Text
  /// For code submissions: the editor language id (e.g. "python"), so the
  /// review UI can highlight it. Null for plain-text / file submissions.
  language     String?
  fileUrl      String?
  /// MIME type of fileUrl when it is an uploaded blob (e.g. audio/webm).
  fileMimeType String?
  submittedAt  DateTime  @default(now())
  grade        Int?
  feedback     String?   @db.Text
  gradedById   String?
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation("submissionStudent", fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Enrollment {
  id              String    @id @default(cuid())
  courseId        String
  studentId       String
  createdAt       DateTime  @default(now())
  /// When the student last tapped "Add to calendar" (proxy for reminder set).
  reminderAddedAt DateTime?

  course  Course @relation(fields: [courseId], references: [id])
  student User   @relation(fields: [studentId], references: [id])

  @@unique([courseId, studentId])
  @@index([studentId])
}

model LiveSession {
  id          String        @id @default(cuid())
  courseId    String
  sectionId   String?
  status      SessionStatus @default(SCHEDULED)
  livekitRoom String        @unique
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?

  course            Course             @relation(fields: [courseId], references: [id])
  section           Section?           @relation(fields: [sectionId], references: [id])
  messages          ChatMessage[]
  quizzes           Quiz[]
  attendances       Attendance[]
  assessment        Assessment?
  assignments       Assignment[]
  hifzEntries       HifzEntry[]
  codingAssignments CodingAssignment[]

  @@index([courseId, status])
}

/// One row per student who joined a live session — the attendance signal.
model Attendance {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  joinedAt  DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id])
  student User        @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
}

/// One row per (course, meeting day) the pre-class reminder cron has emailed —
/// the dedupe key so a class occurrence is never reminded twice. `dateKey` is
/// the occurrence's local calendar day in the course tz ("YYYY-MM-DD").
model SessionReminder {
  id       String   @id @default(cuid())
  courseId String
  dateKey  String
  sentAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id])

  @@unique([courseId, dateKey])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  body      String   @db.Text
  /// Same-origin URL of an attached voice note (audio blob in object storage).
  /// Null for plain text messages.
  audioUrl  String?  @db.Text
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@index([sessionId, createdAt])
}

model Quiz {
  id        String   @id @default(cuid())
  sectionId String?
  sessionId String?
  /// Course-scoped quizzes (e.g. a reusable buzzer bank) attach here directly,
  /// so they exist before any session materializes.
  courseId  String?
  type      QuizType
  createdAt DateTime @default(now())

  section   Section?       @relation(fields: [sectionId], references: [id])
  session   LiveSession?   @relation(fields: [sessionId], references: [id])
  course    Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([courseId])
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  body         String @db.Text
  /// string[] — MySQL has no native array type
  options      Json
  correctIndex Int
  timeLimitSec Int    @default(60)
  /// Points the first correct answerer earns (instructor-set per buzzer question).
  points       Int    @default(25)

  quiz    Quiz         @relation(fields: [quizId], references: [id])
  answers QuizAnswer[]
}

model QuizAnswer {
  id          String   @id @default(cuid())
  questionId  String
  studentId   String
  answerIndex Int
  /// Server receipt time — authoritative for buzzer ordering (DATETIME(3)).
  receivedAt  DateTime @default(now())
  isCorrect   Boolean

  question QuizQuestion @relation(fields: [questionId], references: [id])
  student  User         @relation(fields: [studentId], references: [id])

  @@unique([questionId, studentId])
  @@index([questionId, receivedAt])
}

/// Append-only. The Redis leaderboard is a projection of this table.
model PointsLedger {
  id        String       @id @default(cuid())
  studentId String
  courseId  String
  delta     Int
  reason    PointsReason
  /// e.g. questionId or sessionId the points came from
  refId     String?
  createdAt DateTime     @default(now())

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@index([courseId, studentId])
}

model Certificate {
  id               String   @id @default(cuid())
  courseId         String
  studentId        String
  /// Public code embedded in the QR; resolves via /verify/{code}
  verificationCode String   @unique
  pdfUrl           String?
  issuedById       String
  issuedAt         DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id])
  student User   @relation("certStudent", fields: [studentId], references: [id])

  @@unique([courseId, studentId])
}

/// A course document (PDF/DOCX) uploaded to ground AI question drafting. The
/// extracted plain text is stored so drafting doesn't re-parse the file.
model CourseDocument {
  id            String   @id @default(cuid())
  courseId      String
  filename      String
  storageKey    String // object-store key (R2 in prod, disk in dev)
  mimeType      String
  charCount     Int
  extractedText String   @db.LongText
  createdById   String
  createdAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

// ---------- Adaptive assessment (class-end quiz → remediation) ----------
// Deterministic loop: instructor authors a per-Section MC question bank + a
// per-Section remediation-task bank. When a live session ends, an Assessment
// freezes a set of questions; students answer async; grading is exact; missing
// a Section auto-assigns that Section's remediation tasks. No LLM at runtime —
// AI (roadmap) only drafts the two banks at authoring time.

/// Instructor-authored multiple-choice question, tagged by Section (topic).
model AssessmentQuestion {
  id           String   @id @default(cuid())
  courseId     String
  sectionId    String
  body         String   @db.Text
  /// string[] — MySQL has no native array type
  options      Json
  correctIndex Int
  /// Soft-delete flag; questions referenced by past assessments are never hard-deleted.
  active       Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())

  course    Course               @relation(fields: [courseId], references: [id])
  section   Section              @relation(fields: [sectionId], references: [id])
  responses AssessmentResponse[]

  @@index([courseId, sectionId])
}

/// Pre-made work assigned to a student who misses a Section on an assessment.
model RemediationTask {
  id           String   @id @default(cuid())
  courseId     String
  sectionId    String
  title        String
  instructions String?  @db.Text
  active       Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())

  course   Course                @relation(fields: [courseId], references: [id])
  section  Section               @relation(fields: [sectionId], references: [id])
  assigned AssignedRemediation[]

  @@index([courseId, sectionId])
}

/// One assessment instance, materialised when a live session ends. The set of
/// questions is frozen at creation (questionIds) so a later bank edit can't
/// change a live assessment.
model Assessment {
  id          String   @id @default(cuid())
  courseId    String
  sessionId   String   @unique
  sectionId   String? // topic the ended session covered, if any
  /// Frozen string[] of AssessmentQuestion ids, in presentation order.
  questionIds Json
  /// Visible/gated to students. Set from Course.instantClassAssessment when the
  /// quiz materialises; a held quiz (false) is released later by the instructor.
  released    Boolean  @default(true)
  createdAt   DateTime @default(now())

  course   Course              @relation(fields: [courseId], references: [id])
  session  LiveSession         @relation(fields: [sessionId], references: [id])
  attempts AssessmentAttempt[]

  @@index([courseId])
}

/// One student's run at an assessment. Scored deterministically on submit.
model AssessmentAttempt {
  id           String    @id @default(cuid())
  assessmentId String
  studentId    String
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  score        Int? // correct answers
  total        Int? // questions in the assessment

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    User                 @relation(fields: [studentId], references: [id])
  responses  AssessmentResponse[]

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model AssessmentResponse {
  id          String  @id @default(cuid())
  attemptId   String
  questionId  String
  answerIndex Int
  isCorrect   Boolean

  attempt  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
}

/// A remediation task routed to a student because they missed its Section.
model AssignedRemediation {
  id          String            @id @default(cuid())
  studentId   String
  taskId      String
  /// The attempt that triggered this (also dedupes re-runs).
  attemptId   String
  sectionId   String // denormalized: the missed topic
  status      RemediationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  student User            @relation(fields: [studentId], references: [id])
  task    RemediationTask @relation(fields: [taskId], references: [id])

  @@unique([attemptId, taskId])
  @@index([studentId, status])
}

/// A memorization goal an instructor sets for one student: a surah/ayah range
/// to have memorized by an optional due date. Progress is logged via HifzEntry.
model HifzTarget {
  id          String    @id @default(cuid())
  courseId    String
  studentId   String
  surahNumber Int
  ayahStart   Int
  ayahEnd     Int
  dueAt       DateTime?
  note        String?   @db.Text
  createdById String
  createdAt   DateTime  @default(now())

  course    Course @relation(fields: [courseId], references: [id])
  student   User   @relation("hifzTargetStudent", fields: [studentId], references: [id])
  createdBy User   @relation("hifzTargetCreator", fields: [createdById], references: [id])

  @@index([courseId])
  @@index([studentId])
}

/// One logged recitation: new memorization or revision (muraja'ah) of a
/// surah/ayah range, with the instructor's rating and tajweed notes.
model HifzEntry {
  id           String   @id @default(cuid())
  courseId     String
  studentId    String
  surahNumber  Int
  ayahStart    Int
  ayahEnd      Int
  kind         HifzKind
  /// Instructor's rating of the recitation, 1 (needs work) .. 5 (mastered).
  rating       Int?
  /// Free-text tajweed / correction notes for the student.
  tajweed      String?  @db.Text
  notes        String?  @db.Text
  /// Live session this recitation was logged in (when logged from the class room).
  sessionId    String?
  recordedById String
  recordedAt   DateTime @default(now())

  course     Course       @relation(fields: [courseId], references: [id])
  student    User         @relation("hifzEntryStudent", fields: [studentId], references: [id])
  recordedBy User         @relation("hifzEntryRecorder", fields: [recordedById], references: [id])
  session    LiveSession? @relation(fields: [sessionId], references: [id])

  @@index([courseId, studentId])
  @@index([studentId])
  @@index([sessionId])
}

// ===================== Test Prep (add-on pack: test-prep) =====================
// Standalone, instructor-authored timed mock exams — distinct from the
// session-scoped Assessment flow above. Gated on the `test-prep` plugin.

model Exam {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  /// Time limit in minutes; an attempt auto-scores whatever's answered at the deadline.
  durationMinutes Int
  active          Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())

  course    Course         @relation(fields: [courseId], references: [id])
  createdBy User           @relation("examCreator", fields: [createdById], references: [id])
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([courseId])
}

model ExamQuestion {
  id           String   @id @default(cuid())
  examId       String
  body         String   @db.Text
  /// string[] — MySQL has no native array type
  options      Json
  correctIndex Int
  /// Optional topic label, drives per-topic analytics (e.g. "Algebra").
  topic        String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  exam    Exam         @relation(fields: [examId], references: [id])
  answers ExamAnswer[]

  @@index([examId])
}

model ExamAttempt {
  id          String    @id @default(cuid())
  examId      String
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  /// Percent correct (0–100), set on submit.
  score       Int?

  exam    Exam         @relation(fields: [examId], references: [id])
  student User         @relation("examAttemptStudent", fields: [studentId], references: [id])
  answers ExamAnswer[]

  @@index([examId, studentId])
}

model ExamAnswer {
  attemptId   String
  questionId  String
  chosenIndex Int

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id])
  question ExamQuestion @relation(fields: [questionId], references: [id])

  @@id([attemptId, questionId])
}

/// Org-agnostic pool of questions already pulled from ALOC, keyed by ALOC's own
/// question id. Import checks here first so repeat pulls cost no credits. Past
/// questions are the same for every tenant, so the pool is shared globally.
model AlocQuestionCache {
  id           String   @id // ALOC's question id
  subject      String
  examType     String
  year         Int?
  body         String   @db.Text
  options      Json
  correctIndex Int
  topic        String?
  fetchedAt    DateTime @default(now())

  @@index([subject, examType, year])
}

/// ============================================================
/// Coding Instructor Plugin
/// Rich coding assignments (requirements + weighted rubric), multi-attempt
/// ZIP submissions, and AI (Claude) code review the instructor always overrides.
/// Kept separate from the simpler `Assignment`/`Submission` coursework models.
/// Excluded by product decision: automated test execution, sandboxing, AI tutor.
/// ============================================================

enum CodingAssignmentStatus {
  DRAFT
  LIVE
  CLOSED
}

/// Whether a coding task runs in a live session (LIVE) or is set against the
/// next class as homework (ASSIGNMENT). Drives launch + broadcast behaviour.
enum CodingAssignmentKind {
  LIVE
  ASSIGNMENT
}

/// A submission's place in the review pipeline (no test/sandbox stages).
enum CodingSubmissionStatus {
  SUBMITTED // received, awaiting review
  UNDER_REVIEW // AI review running
  AI_REVIEWED // AI done, awaiting the instructor
  NEEDS_REVIEW // AI flagged low-confidence / borderline
  PASSED
  FAILED
  RETURNED // instructor sent feedback; resubmission allowed
}

/// Per-requirement (and final) assessment.
enum CodingVerdict {
  PASS
  PARTIAL
  FAIL
}

enum CodingFindingKind {
  BUG
  SECURITY
  QUALITY
  ARCHITECTURE
  STRENGTH
}

enum AiConfidence {
  HIGH
  MEDIUM
  LOW
}

enum AiReviewStatus {
  QUEUED
  RUNNING
  DONE
  ERROR
}

model CodingAssignment {
  id               String                 @id @default(cuid())
  courseId         String
  /// Optional live session this task was launched in ("Practice now").
  sessionId        String?
  createdById      String
  /// Live task (runs in a session) vs assignment (homework for the next class).
  kind             CodingAssignmentKind   @default(ASSIGNMENT)
  title            String
  description      String?                @db.Text
  language         String? // e.g. "typescript"
  framework        String? // e.g. "NestJS"
  difficulty       String? // "Beginner" | "Intermediate" | "Advanced"
  /// Same-origin URL of the optional starter project archive in object storage.
  starterFileUrl   String?
  status           CodingAssignmentStatus @default(DRAFT)
  dueAt            DateTime?
  /// Live practice window in seconds (null = untimed homework).
  timeLimitSec     Int?
  maxAttempts      Int                    @default(3)
  allowResubmit    Boolean                @default(true)
  /// Keep the highest attempt's score as final (vs. the latest attempt).
  keepHighest      Boolean                @default(true)
  passingScore     Int                    @default(70)
  /// Run the AI review automatically when a student submits.
  aiAutoReview     Boolean                @default(true)
  /// Release AI feedback to students (the instructor always sees it first).
  showAiToStudents Boolean                @default(false)
  createdAt        DateTime               @default(now())

  course       Course              @relation(fields: [courseId], references: [id])
  session      LiveSession?        @relation(fields: [sessionId], references: [id])
  createdBy    User                @relation("codingCreator", fields: [createdById], references: [id])
  requirements CodingRequirement[]
  rubric       CodingRubricItem[]
  submissions  CodingSubmission[]

  @@index([courseId])
  @@index([sessionId])
}

model CodingRequirement {
  id           String  @id @default(cuid())
  assignmentId String
  order        Int
  text         String  @db.Text
  mandatory    Boolean @default(false)

  assignment CodingAssignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  results    CodingRequirementResult[]

  @@index([assignmentId])
}

model CodingRubricItem {
  id             String  @id @default(cuid())
  assignmentId   String
  order          Int
  criterion      String
  weight         Int // percentage
  mandatory      Boolean @default(false)
  /// Extra evaluation guidance handed to the AI reviewer for this criterion.
  aiInstructions String? @db.Text

  assignment CodingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model CodingSubmission {
  id               String                 @id @default(cuid())
  assignmentId     String
  studentId        String
  attemptNumber    Int                    @default(1)
  /// Same-origin URL of the immutable stored project archive.
  archiveUrl       String?
  /// Content hash of the archive, so a submission references an exact state.
  archiveHash      String?
  status           CodingSubmissionStatus @default(SUBMITTED)
  /// AI-computed provisional score (0–100) before the instructor decides.
  provisionalScore Int?
  /// Instructor's final score + decision (overrides the AI).
  finalScore       Int?
  finalDecision    CodingVerdict?
  reviewedById     String?
  reviewedAt       DateTime?
  submittedAt      DateTime               @default(now())

  assignment CodingAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                   @relation("codingStudent", fields: [studentId], references: [id])
  reviewedBy User?                  @relation("codingReviewer", fields: [reviewedById], references: [id])
  files      CodingSubmissionFile[]
  reviews    CodingAiReview[]
  feedback   CodingFeedback[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId])
  @@index([studentId])
}

model CodingSubmissionFile {
  id           String  @id @default(cuid())
  submissionId String
  /// Repo-relative path inside the archive, e.g. "src/books/books.controller.ts".
  path         String  @db.Text
  size         Int
  language     String?

  submission CodingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model CodingAiReview {
  id            String         @id @default(cuid())
  submissionId  String
  provider      String // e.g. "anthropic"
  model         String // e.g. "claude-sonnet-5"
  promptVersion String // so reviews can be audited / reproduced
  status        AiReviewStatus @default(QUEUED)
  score         Int? // 0–100
  confidence    AiConfidence?
  summary       String?        @db.Text
  error         String?        @db.Text
  createdAt     DateTime       @default(now())

  submission CodingSubmission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  findings   CodingAiFinding[]
  results    CodingRequirementResult[]

  @@index([submissionId])
}

model CodingAiFinding {
  id         String            @id @default(cuid())
  reviewId   String
  kind       CodingFindingKind
  title      String
  body       String            @db.Text
  confidence AiConfidence      @default(MEDIUM)

  review CodingAiReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model CodingRequirementResult {
  id            String        @id @default(cuid())
  reviewId      String
  requirementId String
  verdict       CodingVerdict

  review      CodingAiReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  requirement CodingRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([reviewId, requirementId])
  @@index([reviewId])
  @@index([requirementId])
}

model CodingFeedback {
  id               String   @id @default(cuid())
  submissionId     String
  authorId         String
  body             String   @db.Text
  /// Inline code-comment anchor (optional): file path + line number.
  filePath         String?  @db.Text
  line             Int?
  visibleToStudent Boolean  @default(true)
  createdAt        DateTime @default(now())

  submission CodingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User             @relation("codingFeedbackAuthor", fields: [authorId], references: [id])

  @@index([submissionId])
}

// ===========================================================================
// Platform admin: audit trail + AI-model usage tracking
// ===========================================================================

/// Immutable audit trail of security- and admin-relevant actions. Actor/org are
/// stored as denormalized snapshots (id + email) rather than FK relations, so a
/// row survives the user/org being deleted and can never be silently rewritten.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  // Who did it (null = system/anonymous, e.g. a failed login for an unknown email).
  actorId    String?
  actorEmail String?
  actorRole  String?
  // Where it happened (the actor's tenant, when applicable).
  orgId      String?
  // What happened — a stable dotted slug, e.g. "auth.login.success",
  // "admin.user.status.changed" (see AuditAction constants in audit.service).
  action     String
  // What it acted on.
  targetType String?
  targetId   String?
  // Free-form context (before/after values, reason, etc.). MySQL JSON.
  metadata   Json?
  ip         String?
  userAgent  String?  @db.Text

  @@index([at])
  @@index([action, at])
  @@index([actorId, at])
  @@index([orgId, at])
  @@index([targetType, targetId])
}

enum AiUsageFeature {
  CODING_REVIEW
  ASSESSMENT_DRAFT
}

/// One row per AI model call, with token counts and an estimated USD cost, for
/// the admin usage dashboard. Decoupled snapshots (no FK relations) like AuditLog.
model AiUsage {
  id           String         @id @default(cuid())
  at           DateTime       @default(now())
  feature      AiUsageFeature
  provider     String // e.g. "google"
  model        String // e.g. "gemini-flash-lite-latest"
  orgId        String?
  userId       String?
  promptTokens Int            @default(0)
  outputTokens Int            @default(0)
  totalTokens  Int            @default(0)
  // Estimated cost in USD micro-units? No — store as a Decimal for accuracy.
  estCostUsd   Decimal        @default(0) @db.Decimal(12, 6)
  // Optional pointer to the thing reviewed/generated (e.g. a submission id).
  refId        String?
  // "ok" | "error" — a failed/again-billed call still records what it cost.
  status       String         @default("ok")

  @@index([at])
  @@index([feature, at])
  @@index([model, at])
  @@index([orgId, at])
}

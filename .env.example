# Copy to apps/api/.env (Prisma and Nest read from there)

# MySQL (matches docker-compose.yml)
DATABASE_URL="mysql://livetich:livetich@localhost:3306/livetich"

# Redis (socket.io adapter, leaderboards, quiz state, BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me"

# LiveKit (create a project at https://cloud.livekit.io)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Cloudflare R2 (S3-compatible) — recordings, certificate PDFs
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="livetich"

# Certificates
# Base URL embedded in certificate QR codes (public verify endpoint)
CERT_VERIFY_BASE="http://localhost:3000/certificates/verify"
# Where generated PDFs are written until R2 is wired up
CERT_STORAGE_DIR="./storage/certificates"

# Chalkboard
# Where Yjs board snapshots are written until R2 is wired up
BOARD_STORAGE_DIR="./storage/boards"

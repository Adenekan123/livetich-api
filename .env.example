# Copy to apps/api/.env (Prisma and Nest read from there)

# MySQL (matches docker-compose.yml)
DATABASE_URL="mysql://livetich:livetich@localhost:3306/livetich"

# Redis (socket.io adapter, leaderboards, quiz state, BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me"

# LiveKit (create a project at https://cloud.livekit.io)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Object storage (certificate PDFs + board snapshots)
# Set all four R2_* vars to use Cloudflare R2 (S3-compatible); if any is
# missing, the app falls back to local disk under STORAGE_DIR.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="livetich"
# Local-disk fallback root (used only when R2 is not configured)
STORAGE_DIR="./storage"

# Certificates
# Base URL embedded in certificate QR codes (public verify endpoint)
CERT_VERIFY_BASE="http://localhost:3000/certificates/verify"

# Copy to apps/api/.env (Prisma and Nest read from there)

# MySQL (matches docker-compose.yml)
DATABASE_URL="mysql://livetich:livetich@localhost:3306/livetich"

# Redis (socket.io adapter, leaderboards, quiz state, BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me"

# LiveKit (create a project at https://cloud.livekit.io)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Object storage (certificate PDFs + board snapshots)
# Set all four R2_* vars to use Cloudflare R2 (S3-compatible); if any is
# missing, the app falls back to local disk under STORAGE_DIR.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="livetich"

# How hard to compress session recordings:
#   high     1080p30  — LiveKit's default, for when storage is not a concern
#   balanced 1080p15  — the default; full resolution so handwriting and the
#                       mushaf stay sharp, everything else turned down
#   compact  720p12   — half the pixels; slide text survives, fine detail softens
#   minimal  720p8    — barely video; for keeping lessons, not re-watching them
# A lesson is mostly still, so real sizes land well under these ceilings.
RECORDING_QUALITY="balanced"
# Local-disk fallback root (used only when R2 is not configured)
STORAGE_DIR="./storage"

# Test Prep add-on: ALOC past-questions API (JAMB/WAEC/NECO/Post-UTME).
# Free dev tier — register at https://questions.aloc.com.ng for a key. Import
# is disabled (endpoint 503s) if unset. ALOC_API_URL defaults to the v1 base.
ALOC_API_KEY=""
# ALOC_API_URL="https://dev.aloc.com.ng/api/v1"

# Certificates
# Base URL embedded in certificate QR codes (public verify endpoint)
CERT_VERIFY_BASE="http://localhost:3000/certificates/verify"

# Recording the whole class (board, mushaf, shared media — not just the camera)
# needs LiveKit's browser to reach WEB_URL over the internet. Before each
# recording the API checks that WEB_URL actually answers — a localhost value, or
# a tunnel hostname that has since died, both fail that check and Record is
# refused with the reason, rather than quietly filming the room instead and
# producing a black rectangle with no board in it.
# Two URLs, not one. The page is opened on LiveKit's machines, so every fetch
# and socket it then makes needs an API address that resolves from there too —
# a localhost API_PUBLIC_URL gives a page that loads and then fails at its first
# request, which films as a full-screen error, i.e. a black video.
#
# Locally: pnpm dev:tunnel opens a tunnel to both ports and writes both values
# here, then restores them on Ctrl-C. Do not hand-edit them for local work — a
# quick tunnel gets a new hostname every start, and the stale one left behind is
# what breaks recording between sessions.
#
# In a deployment both are simply the public origins of the web app and the API.
API_PUBLIC_URL="https://api.example.com"
#
# Set this to keep the old behaviour, where an unreachable WEB_URL falls back to
# recording the room's camera and mic only. Worth having where cameras are
# reliably on and the board is not the point; a trap everywhere else.
# RECORDING_ALLOW_CAMERA_ONLY="true"
